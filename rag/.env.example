# 复制此文件为 .env 并填写实际值

# ── 向量嵌入 API（需支持 OpenAI 兼容接口）──────────────────────────────
# 示例服务：SiliconFlow / 阿里云 DashScope / 本地 Ollama / 任意 OpenAI 兼容接口
EMB_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMB_BASE_URL=https://api.siliconflow.cn/v1
EMB_MODEL=BAAI/bge-m3

# ── 大语言模型 API（需支持 OpenAI 兼容接口）────────────────────────────
# 可与嵌入 API 相同，也可使用不同服务商
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3

# ── Elasticsearch 地址（默认本地 Docker）───────────────────────────────
ES_HOST=http://localhost:9201
